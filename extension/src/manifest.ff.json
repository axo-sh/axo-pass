{
  "name": "__MANIFEST_NAME__",
  "version": "__MANIFEST_VERSION__",
  "description": "__MANIFEST_DESCRIPTION__",
  "homepage_url": "https://github.com/octavore",
  "manifest_version": 3,
  "icons": {
    "48": "axo-dark.svg",
    "96": "axo-dark.svg"
  },
  "permissions": ["nativeMessaging", "storage", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MANIFEST_NAME__",
    "default_popup": "popup.html",
    "default_icon": "axo-dark.svg",
    "theme_icons": [
      {
        "dark": "axo-light.svg",
        "light": "axo-dark.svg",
        "size": 16
      },
      {
        "dark": "axo-light.svg",
        "light": "axo-dark.svg",
        "size": 32
      }
    ]
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    },
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Fill the login for this page"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "axo-pass@breakfastlabs.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
