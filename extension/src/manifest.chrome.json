{
  "name": "__MANIFEST_NAME__",
  "version": "__MANIFEST_VERSION__",
  "description": "__MANIFEST_DESCRIPTION__",
  "homepage_url": "https://github.com/octavore",
  "manifest_version": 3,
  "permissions": ["nativeMessaging", "storage", "contextMenus", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "__MANIFEST_NAME__",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      }
    },
    "fill-login": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Fill the login for this page, the one-time code in a code field, or a generated password in a new password field"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
