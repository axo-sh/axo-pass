#!/bin/bash
set -euxo pipefail

# Build the Firefox package and archive the extension source for AMO review.
# A reviewer reproduces the build from the source archive with:
#     npm ci && webpack --env target=ff
#     cd build/ff
# Run from extension/. The source archive is HEAD:extension, so commit first.

cd "$(dirname "$0")/.."

PREFIX=$(git rev-parse --short HEAD)-$(date +%Y%m%d%H%M%S)
OUTPUT_DIR=$(pwd)/build
mkdir -p "$OUTPUT_DIR"

echo "====> Building Firefox extension..."
npm ci
webpack --env target=ff

echo "====> Creating archive for submission..."
(cd build/ff && zip -r "$OUTPUT_DIR/$PREFIX-ffextension.zip" .)

echo "====> Creating archive for review..."
git archive -o "$OUTPUT_DIR/$PREFIX-ffreview.tar.gz" HEAD:extension

set +x

echo
echo "Done. Upload both archives to https://addons.mozilla.org/developers/"
